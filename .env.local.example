# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used by app/api/cron/fetch-scores to write games/picks (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — protects the cron route from being called by anyone.
# Call it with header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=some-random-string

# Optional — only needed if you want the "Generate AI Recap" button to call
# a real model instead of the built-in free text-template fallback.
ANTHROPIC_API_KEY=
